{
  "name": "labkit-central",
  "version": "1.0.0",
  "description": "LabKit Central - Laboratory Equipment Loan Management System",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "server": "nodemon app.js",
    "dev": "concurrently -k -n \"API,VITE\" -c \"cyan,green\" \"npm run server\" \"npm run vite\"",
    "vite": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node database/seed.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "express",
    "sqlite",
    "equipment-management",
    "rest-api",
    "loan-management",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "vite": "^8.3.8"
  }
}
